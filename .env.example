# ── LLM provider ──────────────────────────────────────────────────────────────
# DigitalOcean serverless inference (default):
# LLM_BASE_URL=https://inference.do-ai.run/v1
# LLM_API_KEY=your_do_gen_ai_api_key_here
# LLM_MODEL=llama3.3-70b-instruct

# ── OR Ollama (local) ─────────────────────────────────────────────────────────
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# ── OR OpenAI-compatible (e.g. Together.ai, Groq, Fireworks) ─────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# ── GitHub (optional but strongly recommended) ────────────────────────────────
# Without this, GitHub API allows only 60 req/hour per IP.
# Create a fine-grained token at https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN=your_github_personal_access_token_here